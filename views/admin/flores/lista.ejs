<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-flower1"></i>
                    Flores
                </h4>
                <a href="/admin/flores/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Nova flor
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Flor</th>
                            <th>Espécie</th>
                            <th>Cor</th>
                            <th>Valor</th>
                            <th>Estoque</th>
                            <th>Imagem</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% flores.forEach(flor => { %>
                            <tr>
                                <td><%= flor.id %></td>
                                <td><%= flor.nome %></td>
                                <td><%= flor.especie %></td>
                                <td><%= flor.cor %></td>
                                <td>R$ <%= Number(flor.valor).toFixed(2).replace('.', ',') %></td>
                                <td><%= flor.estoque %></td>
                                <td>
                                    <% if (flor.imagem) { %>
                                        <img src="/uploads/<%= flor.imagem %>" alt="<%= flor.nome %>" style="height:50px;">
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/admin/flores/<%= flor.id %>/form-editar" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>
                                    <a href="/admin/flores/<%= flor.id %>/excluir" class="btn btn-danger btn-sm" onclick="return confirm('Tem certeza que deseja excluir esta flor?')">
                                        <i class="bi bi-trash"></i>
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

<%- include('../partials/footer') %>
