                </div>
            </div>
            
            <div class="col-md-4 mb-3">
                <div class="card fundo2">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-flower1"></i>
                            Flores de vaso
                        </h5>
                        <p class="card-text">
                            Cadastre e consulte as flores de vaso da Sweet Flowers.
                        </p>
                        <a href="/admin/flores-de-vaso" class="btn btn-light">
                            Ver flores
                        </a>
                    </div>
                </div>
            </div>
        

        </div>
